# Konfigurasi Aplikasi Restoran Savoria
RESTAURANT_NAME="Savoria Japanese Dining"
RESTAURANT_WHATSAPP_NUMBER="6281234567890"

# Pajak & Biaya Layanan
TAX_RATE=0.10
SERVICE_FEE_RATE=0.05

# Database Configuration (MySQL)
DB_TYPE="mysql"
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB="savoria"

# Fallback SQLite File (Opsional)
DB_FILE="savoria.db"

# Kunci API Opsional (Untuk Fitur LLM Pintar di Masa Depan)
GEMINI_API_KEY=""
